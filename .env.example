# Optional: enables Gemini-powered analysis. Without a key, built-in summaries remain available.
GEMINI_API_KEY=

# Required when NODE_ENV=production. Use a unique username and a password of at least 16 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: use a persistent storage path on the hosting service.
VAT_DATABASE_PATH=./vat_database.db
